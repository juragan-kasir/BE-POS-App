{
  "name": "pos-backend",
  "version": "1.0.0",
  "description": "POS Backend API",
  "main": "api/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "nodemon api/index.js",
    "dev": "nodemon api/index.js",
    "sync": "node scripts/migrate.js",
    "sync:inventory": "node scripts/migrate-inventory.js",
    "reset-data": "node scripts/reset-data.js",
    "seed:regions": "node scripts/seed-regions.js",
    "demo:db": "bash scripts/setup-warung-demo-db.sh",
    "demo:seed": "node scripts/seed-warung-demo.js",
    "demo:reset": "bash scripts/reset-warung-demo-db.sh",
    "migrate": "node scripts/run-migrations.js",
    "db:bootstrap": "node scripts/bootstrap-db.js",
    "migrate:create": "sequelize-cli migration:generate",
    "guard:force-sync": "node scripts/check-no-force-sync.js",
    "check:production-schema": "node scripts/check-production-schema.js",
    "check:migration-preflight": "node scripts/check-migration-preflight.js",
    "rehearse:staging": "node scripts/rehearse-staging.js",
    "test": "node scripts/run-tests-sharded.js",
    "test:isolation": "node --experimental-vm-modules node_modules/.bin/jest __tests__/ingredient-isolation.test.js --forceExit --detectOpenHandles"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@sentry/node": "^10.73.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.14",
    "mime": "^2.6.0",
    "mime-types": "^2.1.35",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "node-localstorage": "^3.0.5",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.3",
    "sequelize-cli": "6.6.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/scripts/setup-test-db.js",
    "testTimeout": 30000,
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ]
  }
}
