{
  "version": 2,
  "regions": ["sin1"],
  "crons": [
    { "path": "/internal/accounting-outbox/drain", "schedule": "0 0 * * *" },
    { "path": "/internal/qr-orders/expire", "schedule": "0 0 * * *" },
    { "path": "/internal/backup/run", "schedule": "0 0 * * *" }
  ],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "memory": 1024,
        "timeout": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
       "headers": {
         "cache-control": "no-cache, no-store, must-revalidate"
       }
    }
  ]
}
