# Copy to .env locally and fill in real values. NEVER commit .env.

# --- App / server ---
# DR-24 D-08: public self-registration (/auth/register) is CLOSED unless this
# is exactly "true". Keep it unset in production; staff are created by the owner.
PUBLIC_REGISTRATION_ENABLED=
NODE_ENV=
# Render/most hosts inject this automatically; the app already honors
# process.env.PORT with a 5001 fallback (api/index.js). Usually leave unset.
PORT=
# Number of trusted proxies in front of the API. The LAN-only print endpoint
# uses it to resolve the real client address from X-Forwarded-For. Leave
# unset for a direct/LAN deployment; set 1 on a single-proxy host (e.g. a
# reverse proxy in front of the store server).
TRUST_PROXY_HOPS=

# --- Internal scheduler endpoints (/internal/*, Vercel Cron) ---
# Must be at least 32 characters. The endpoints fail closed with 503 while
# this is unset. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# --- Production database (managed Postgres, e.g. Neon) ---
# IMPORTANT: config/config.js's `production` block reads these four discrete
# vars, NOT a single connection-string env var — `use_env_variable` (the
# Sequelize config key that would read one) is never set for any
# environment, so a bare DATABASE_URL is silently ignored. SSL is already
# forced on for this block (dialectOptions.ssl), matching Neon's requirement.
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Local/dev database (used by local dev runs and dev schema scripts) ---
DB_DEV_HOST=
DB_DEV_PORT=
DB_DEV_USERNAME=
DB_DEV_PASSWORD=
DB_DEV_DATABASE=

# --- Auth ---
JWT_SECRET_KEY=
# Falls back to '1d' if unset (utils/jwtConvert.js) — optional.
JWT_EXPIRED_IN=
# Lifetime when the client asks to be remembered. Falls back to '30d' — optional.
JWT_REMEMBER_ME_EXPIRED_IN=

# --- CORS (api/utils/corsOptions.js) ---
# Which deployed frontend origin(s) may call this API. CORS_ORIGIN is a
# comma-separated allowlist (replaces the built-in default list entirely);
# FRONTEND_URL appends one more origin on top of the built-in defaults.
# Only relevant in production — localhost/127.0.0.1 are always allowed in
# non-production regardless of these vars.
CORS_ORIGIN=
FRONTEND_URL=

# --- Redis (optional; queue/worker features) ---
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_TTL=

# --- Cloudinary (required for image upload features: categories, employees,
# goods receipts, invoices, purchase returns, product bundles) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Error tracking (optional; no-ops without a DSN — api/instrument.js) ---
SENTRY_DSN=
# --- AI personal assistant (ai-business-core, Telegram) ---
# Shared secret the AI service sends as `Authorization: Bearer ...` when it
# reads store data from /assistant/stores/:storeId/*. Min. 32 chars; the
# endpoints answer 503 while unset.
ASSISTANT_SERVICE_SECRET=
# ai-business-core base URL + its API key (admin permission) for the owner's
# "Connect Telegram" flow (/assistant/telegram-link). 503 while unset.
AI_CORE_URL=
AI_CORE_API_KEY=

# --- Attendance geofence ---
# Maximum distance (metres) between the clock-in GPS point and the employee's
# assigned store coordinates. Defaults to 200 when unset. Stores without
# latitude/longitude keep the accuracy-only check.
ATTENDANCE_GEOFENCE_METERS=
